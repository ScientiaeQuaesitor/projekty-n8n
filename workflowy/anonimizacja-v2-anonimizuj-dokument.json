        "onError": "continueErrorOutput",
        "notes": "Why HTTP: własny lokalny serwis anonimizator, nie ma dla niego węzła. Bez ponowień: drugie wysłanie pliku utworzyłoby drugie zadanie.",
        "parameters": {
          "method": "POST",
          "url": "http://anonimizator:8000/dokumenty",
          "sendBody": true,
          "contentType": "multipart-form-data",
          "bodyParameters": {
            "parameters": [
              {
                "parameterType": "formBinaryData",
                "name": "plik",
                "inputDataFieldName": "plik"
              },
              {
                "name": "sesja",
